{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webapp",
	"compatibility_date": "2026-03-11",
	"pages_build_output_dir": "./dist",
	"compatibility_flags": [
		"nodejs_compat"
	],

	// ── PRODUCTION — what `npm run deploy` uses. Real customer data. ──
	// APP_ENV drives the staging banner (see /api/env in src/index.ts). Anything
	// but the literal "staging" means production, so the banner can never appear
	// over live data by accident.
	"vars": {
		"APP_ENV": "production",
		// Origin used in emailed links (owner invites), so they can never point at
		// the pages.dev duplicate. Deliberately NOT set under env.preview: there the
		// request's own origin is used, which keeps staging links on staging.
		"PUBLIC_URL": "https://foodnance.com",
		// Paddle LIVE (switched on 2026-10-21, after Paddle approved the account).
		// Public by design: the client token can only open a checkout. With these
		// set, a new account's owner must add a card before using the app; every
		// account that existed before 0065 is billing_exempt.
		"PADDLE_ENV": "production",
		"PADDLE_CLIENT_TOKEN": "live_779f5af78720cee93cf00aec25e",
		"PADDLE_PRICE_ESSENTIAL": "pri_01m5cmwbdwcrft7cxfeb1wc592",
		"PADDLE_PRICE_PRO": "pri_01m5cmt3gc0ep0kstkcha7rr35"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "invoicedb-production",
			"database_id": "471dbf32-65e1-4a71-9f6e-dce00b1cffc5"
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "invoicedb-files"
		}
	],

	// ── STAGING — what `npm run deploy:staging` uses. ──────────────
	//
	// Cloudflare Pages has exactly two environments, "production" and "preview".
	// A deployment made with `--branch staging` (anything other than the
	// production branch) is a PREVIEW deployment, and preview deployments read
	// the bindings below instead of the ones above.
	//
	// The binding NAMES are identical on purpose — `DB` and `FILES` on both
	// sides. src/index.ts never learns there are two environments; only the
	// cabinet behind the name changes. So there is no branch in the code that
	// could be wrong, and nothing to remember when writing a query.
	//
	// This exists because every deployment URL Cloudflare has ever issued for
	// this project pointed at the LIVE database. An old deploy URL looks like a
	// sandbox and is not one: it is different code wired to real customer rows,
	// so "just checking what the old version did" could void a real invoice.
	//
	// It also gives migrations somewhere to be rehearsed. Production migrations
	// are applied here by hand against live D1 — 0038 and 0042 both rebuilt a
	// table — and until now the only dress rehearsal was a local SQLite file
	// that has drifted from production before (0033 had its column but not its
	// index, and nobody noticed for weeks).
	//
	// Set the staging database up with:  npm run db:migrate:staging
	// It needs its own API key, or invoice parsing there will fail:
	//   npx wrangler pages secret put ANTHROPIC_API_KEY --project-name webapp
	"env": {
		"preview": {
			"vars": {
				"APP_ENV": "staging",
				// Paddle SANDBOX (billing plan step 2). Public by design: the client
				// token can only open a checkout. Production has none of these, so
				// there is no card step there until billing goes live.
				"PADDLE_ENV": "sandbox",
				"PADDLE_CLIENT_TOKEN": "test_f64cf3063a3af875abc336b2bca",
				"PADDLE_PRICE_ESSENTIAL": "pri_01m5bwchn0gyfhpj8pcqs62prj",
				"PADDLE_PRICE_PRO": "pri_01m5bwcj3cm2mh11zv3dkb25ap"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "invoicedb-staging",
					"database_id": "5a6d0914-7e25-4a29-844d-18edafeb5378"
				}
			],
			"r2_buckets": [
				{
					"binding": "FILES",
					"bucket_name": "invoicedb-files-staging"
				}
			]
		}
	}
}
